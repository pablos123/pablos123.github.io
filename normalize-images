#!/usr/bin/env bash
# Normalize every raster image in this repo to PNG; originals go to a per-run backup dir in /tmp.

set -Eeuo pipefail
shopt -s inherit_errexit

function die {
    printf '\033[1;31m[ERROR]\033[0m %s\n' "${1:-}" >&2
    exit 1
}

function warn {
    printf '\033[1;33m[WARN]\033[0m %s\n' "${1:-}" >&2
}

function require_commands {
    local -a missing=()
    local command_name
    for command_name in "$@"; do
        if ! command -v "${command_name}" >/dev/null; then
            missing+=("${command_name}")
        fi
    done

    ((${#missing[@]} == 0)) || die "missing commands: ${missing[*]}"
}

require_commands chmod cmp convert dirname find head identify mkdir mktemp mv rm sort

declare -ra PNG_EXCLUDES=(
    -define 'png:exclude-chunks=gAMA,cHRM,pHYs,tEXt,zTXt,iTXt,tIME,bKGD,hIST'
)

declare -ra CONVERT_FLAGS=(
    -auto-orient -strip -depth 8 -colorspace sRGB
    -define png:compression-level=9 "${PNG_EXCLUDES[@]}"
)

function main {
    local run_backup_dir
    run_backup_dir="$(mktemp -d /tmp/normalize-images.XXXXXX)"

    local -a images
    mapfile -d '' -t images < <(
        find . -path './.git' -prune -o -path './node_modules' -prune -o \
            -path './vendor' -prune -o -type f \( \
            -iname '*.png' -o -iname '*.jpg' -o -iname '*.jpeg' \
            -o -iname '*.bmp' -o -iname '*.tif' -o -iname '*.tiff' \
            -o -iname '*.webp' -o -iname '*.gif' -o -iname '*.avif' \
            -o -iname '*.ico' \) -print0 | sort --zero-terminated
    )

    local -i converted=0
    local -i unchanged=0
    local -i skipped=0

    local source_path
    for source_path in "${images[@]}"; do
        local relative="${source_path#./}"
        local target="${source_path%.*}.png"

        if [[ "${target}" != "${source_path}" && -e "${target}" ]]; then
            warn "${relative}: ${target##*/} already exists, skipping"
            ((++skipped))
            continue
        fi

        local frames
        frames="$(identify -format '%n' "${source_path}" 2>/dev/null | head -1)"
        if [[ "${frames:-1}" != 1 ]]; then
            warn "${relative}: skipped (${frames:-?} frames would lose data)"
            ((++skipped))
            continue
        fi

        local normalized_image
        normalized_image="$(mktemp "${target}.XXXXXX")"
        if ! convert "${source_path}" "${CONVERT_FLAGS[@]}" "PNG:${normalized_image}" 2>/dev/null; then
            warn "${relative}: skipped (conversion failed)"
            rm --force "${normalized_image}"
            ((++skipped))
            continue
        fi

        if cmp --silent "${source_path}" "${normalized_image}"; then
            printf '  = %s: already normalized\n' "${relative}"
            rm --force "${normalized_image}"
            ((++unchanged))
            continue
        fi

        chmod --reference="${source_path}" "${normalized_image}"
        local backup_path="${run_backup_dir}/${relative}"
        mkdir -p -- "$(dirname -- "${backup_path}")"
        mv -- "${source_path}" "${backup_path}"
        mv -- "${normalized_image}" "${target}"
        ((++converted))
        printf '  + %s -> %s\n' "${relative}" "${target#./}"
    done

    printf '\ndone: %d converted, %d already normalized, %d skipped\n' \
        "${converted}" "${unchanged}" "${skipped}"
    printf 'the original images are in %s\n' "${run_backup_dir}"
}

main
